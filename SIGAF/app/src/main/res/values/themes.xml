<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema base para la Activity: sin ActionBar y fondo negro profundo.
         El look real lo define Jetpack Compose (SigafTheme). -->
    <style name="Theme.SIGAF" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sigaf_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

</resources>
